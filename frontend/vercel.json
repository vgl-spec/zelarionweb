      "has": [{ "type": "host", "value": "zelarionweb.vercel.app" }],
      "destination": "https://www.zelarion.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "zelarion.tech" }],
      "destination": "https://www.zelarion.tech/:path*",
      "permanent": true
    }
  ],
